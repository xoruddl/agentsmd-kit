#!/usr/bin/env bash
#
# Java 포맷 검사. 공통 pre-commit 훅이 실행한다.
# Gradle 프로젝트가 붙어 있고 Java 파일이 스테이징됐을 때만 spotlessCheck 를 돌린다.
# 규칙: docs/lint-and-ci.md

set -euo pipefail

if [ -x ./gradlew ] && git diff --cached --name-only | grep -q '\.java$'; then
  if ! ./gradlew -q spotlessCheck; then
    echo "pre-commit: 포맷 위반. ./gradlew spotlessApply 후 다시 스테이징하세요." >&2
    exit 1
  fi
fi
