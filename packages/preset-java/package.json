{
  "name": "@agentsmd/preset-java",
  "version": "0.2.1",
  "description": "Java·Gradle 프로젝트용 AI 작업 지침 프리셋 (코드 규칙 문서, Spotless 커밋 검사, Gradle CI)",
  "keywords": [
    "agents.md",
    "ai-agent",
    "java",
    "gradle",
    "spotless"
  ],
  "homepage": "https://github.com/xoruddl/agentsmd-kit#readme",
  "bugs": "https://github.com/xoruddl/agentsmd-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoruddl/agentsmd-kit.git",
    "directory": "packages/preset-java"
  },
  "license": "MIT",
  "author": "이태경 (https://github.com/xoruddl)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "files"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentsmd/core": "workspace:*"
  }
}
