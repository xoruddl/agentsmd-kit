{
  "name": "@agentsmd/preset-spring",
  "version": "0.5.0",
  "description": "Spring Boot 서버용 AI 작업 지침 프리셋 (구조·JPA·트랜잭션·API·테스트 규칙)",
  "keywords": [
    "agents.md",
    "ai-agent",
    "spring",
    "spring-boot",
    "jpa"
  ],
  "homepage": "https://github.com/xoruddl/agentsmd-kit#readme",
  "bugs": "https://github.com/xoruddl/agentsmd-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoruddl/agentsmd-kit.git",
    "directory": "packages/preset-spring"
  },
  "license": "MIT",
  "author": "이태경 (https://github.com/xoruddl)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "files"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentsmd/core": "workspace:*"
  }
}
