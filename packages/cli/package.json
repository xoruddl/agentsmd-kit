{
  "name": "@agentsmd/cli",
  "version": "0.2.1",
  "description": "AI 코딩 에이전트용 작업 지침(AGENTS.md)을 설치하고 검사하는 CLI",
  "keywords": [
    "agents.md",
    "ai-agent",
    "claude-code",
    "cli",
    "git-hooks"
  ],
  "homepage": "https://github.com/xoruddl/agentsmd-kit#readme",
  "bugs": "https://github.com/xoruddl/agentsmd-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoruddl/agentsmd-kit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "이태경 (https://github.com/xoruddl)",
  "type": "module",
  "bin": {
    "agentsmd": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentsmd/core": "workspace:*",
    "@agentsmd/preset-git": "workspace:*",
    "@agentsmd/preset-java": "workspace:*",
    "@agentsmd/preset-typescript": "workspace:*"
  }
}
