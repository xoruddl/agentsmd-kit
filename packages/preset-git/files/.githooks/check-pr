#!/usr/bin/env bash
#
# PR(GitLab 에서는 MR) 규칙 검사. 훅이 아니라 CI 에서 부르는 스크립트다.
#   - 브랜치 이름: <타입>/<이슈번호>-<짧은-설명>
#   - 제목: [<타입>] <요약>   (예: [Feat] 로그인 추가. 커밋 메시지 형식과 다르다)
#
# 본문은 검사하지 않는다. 이슈 번호는 브랜치 이름으로 이미 강제하고,
# 이슈를 여러 PR 로 나누면 Closes #N 을 쓸 수 없는 PR 이 생기기 때문이다.
#
# 어떤 CI 에서든 값을 환경변수로 넘겨 부른다.
#   BRANCH  PR 브랜치 이름  (필수)
#   TITLE   PR 제목         (필수)
#
# 예: BRANCH=feat/12-login TITLE="[Feat] 로그인 추가" .githooks/check-pr
#
# 타입 목록은 .githooks/commit-msg 의 types 와 같게 유지한다. title_types 는 같은 목록을 제목용으로 쓴 것이다.
# 규칙: docs/git/git-conventions.md

set -uo pipefail

# 브랜치 이름과 커밋은 소문자 타입, PR 제목은 대괄호로 감싼 타입을 쓴다
types='feat|fix|refactor|test|docs|chore|ci|build'
title_types='Feat|Fix|Refactor|Test|Docs|Chore|CI|Build'
failed=0

fail() {
  echo "check-pr: $1" >&2
  failed=1
}

if [ -z "${BRANCH:-}" ] || [ -z "${TITLE:-}" ]; then
  echo "check-pr: BRANCH 와 TITLE 환경변수가 필요합니다" >&2
  exit 2
fi

if ! [[ "$BRANCH" =~ ^(${types})/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  fail "브랜치 이름이 '<타입>/<이슈번호>-<짧은-설명>' 형식이 아닙니다: $BRANCH"
fi

if ! [[ "$TITLE" =~ ^\[(${title_types})\]\ .+ ]]; then
  fail "제목이 '[타입] 요약' 형식이 아닙니다 (예: [Feat] 로그인 추가): $TITLE"
fi

exit $failed
