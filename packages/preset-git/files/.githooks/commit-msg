#!/usr/bin/env bash
#
# 커밋 메시지 검사 훅.
#   - 형식: <타입>: <요약>  (scope 를 쓰지 않는다)
#   - 제목 50자 이내, 마침표로 끝나지 않음
#   - AI 서명 금지
#
# 타입 목록은 .githooks/check-pr 의 types 와 같게 유지한다.
# 사용: .githooks/commit-msg <메시지 파일>
# 규칙: docs/git/git-conventions.md

set -euo pipefail

msg_file="$1"

# 한글 제목 길이를 바이트가 아니라 글자 수로 세기 위해 UTF-8 로케일을 쓴다.
# macOS 는 C.UTF-8, Ubuntu 는 C.utf8 로 표기가 달라서 실제 목록에서 찾는다.
utf8_locale="$(locale -a 2>/dev/null | grep -iE '^(c|en_us)\.utf-?8$' | head -n 1 || true)"
if [ -n "$utf8_locale" ]; then
  export LC_ALL="$utf8_locale"
fi

# git 이 넣는 주석(#) 줄은 실제 메시지가 아니므로 제외한다.
message="$(grep -v '^#' "$msg_file" || true)"
subject="$(printf '%s\n' "$message" | head -n 1)"

fail() {
  echo "commit-msg: $1" >&2
  echo "  제목: $subject" >&2
  echo "  규칙: docs/git/git-conventions.md" >&2
  exit 1
}

# git 이 자동 생성하는 메시지는 형식 검사 대상이 아니다.
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types='feat|fix|refactor|test|docs|chore|ci|build'
pattern="^(${types}): .+"

if ! [[ "$subject" =~ $pattern ]]; then
  fail "형식이 '<타입>: <요약>' 이 아닙니다. 타입: ${types//|/, }"
fi

if [ "${#subject}" -gt 50 ]; then
  fail "제목이 50자를 넘습니다. (${#subject}자)"
fi

if [[ "$subject" == *. ]]; then
  fail "제목을 마침표로 끝내지 않습니다."
fi

# 사람이 쓴 커밋처럼 보이도록 AI 도구 서명을 막는다. (docs/git/writing-style.md)
if printf '%s\n' "$message" | grep -qiE 'co-authored-by:.*(claude|anthropic)|generated with.*claude|🤖'; then
  fail "AI 서명이 포함돼 있습니다. 해당 줄을 지우세요."
fi

exit 0
