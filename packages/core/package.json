{
  "name": "@agentsmd/core",
  "version": "0.1.0",
  "description": "AGENTS.md 문서 지도를 읽고 검사하는 규칙 모음",
  "keywords": [
    "agents.md",
    "ai-agent",
    "lint",
    "documentation"
  ],
  "homepage": "https://github.com/xoruddl/agentsmd-kit#readme",
  "bugs": "https://github.com/xoruddl/agentsmd-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoruddl/agentsmd-kit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "이태경 (https://github.com/xoruddl)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
